set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel

exec hypridle
exec ~/.local/bin/auto_rotate_screen.sh
exec /usr/libexec/sway-systemd/assign-cgroups.py
exec /usr/libexec/sway-systemd/session.sh
exec /usr/libexec/polkit-mate-authentication-agent-1
exec /usr/bin/xdg-user-dirs-update
exec /usr/libexec/sway-systemd/wait-sni-ready && \
    systemctl --user start sway-xdg-autostart.target
# exec swaymsg create_output
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME
exec ~/.local/bin/autotiling

exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme 'catppuccin-latte-green-standard+default'
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus'
    gsettings set org.gnome.desktop.interface font-name 'Fira Sans 12'
    gsettings set org.gnome.desktop.interface color-scheme 'default' 
    gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Original-Ice'
    gsettings set org.gnome.desktop.interface cursor-size 24
}

output * bg ~/pictures/wallpapers/element/Greens.jpg fill

output eDP-1 {
    resolution 1920x1080@60Hz
    pos 0 0
    # scale 1.25
}

input type:touchpad {
    accel_profile adaptive
    drag enabled
    dwt enabled
    drag_lock disabled
    natural_scroll enabled
    scroll_method two_finger
    tap enabled
}

input type:keyboard {
    xkb_layout us,ua
    xkb_options grp:alt_shift_toggle,caps:escape
    xkb_capslock disabled
}

seat * {
    hide_cursor 30000
    xcursor_theme Bibata-Original-Ice 24
}

floating_modifier $mod normal

bindsym {
    $mod+space exec $term
    $mod+Shift+q kill
    $mod+d exec $menu
    $mod+Shift+c reload
    $mod+Shift+e exec swaymsg exit
    $mod+Escape exec swaylock -f
    $mod+f fullscreen
    $mod+Shift+space floating toggle
}

bindsym {
    $mod+1 exec ~/.config/sway/workspaces.sh 1
    $mod+2 exec ~/.config/sway/workspaces.sh 2
    $mod+3 exec ~/.config/sway/workspaces.sh 3
    $mod+4 exec ~/.config/sway/workspaces.sh 4
    $mod+5 exec ~/.config/sway/workspaces.sh 5
    $mod+6 exec ~/.config/sway/workspaces.sh 6
    $mod+7 exec ~/.config/sway/workspaces.sh 7
    $mod+8 exec ~/.config/sway/workspaces.sh 8
    $mod+9 exec ~/.config/sway/workspaces.sh 9
    $mod+0 exec ~/.config/sway/workspaces.sh 10

    $mod+Shift+1 exec ~/.config/sway/workspaces.sh 1 move
    $mod+Shift+2 exec ~/.config/sway/workspaces.sh 2 move
    $mod+Shift+3 exec ~/.config/sway/workspaces.sh 3 move
    $mod+Shift+4 exec ~/.config/sway/workspaces.sh 4 move
    $mod+Shift+5 exec ~/.config/sway/workspaces.sh 5 move
    $mod+Shift+6 exec ~/.config/sway/workspaces.sh 6 move
    $mod+Shift+7 exec ~/.config/sway/workspaces.sh 7 move
    $mod+Shift+8 exec ~/.config/sway/workspaces.sh 8 move
    $mod+Shift+9 exec ~/.config/sway/workspaces.sh 9 move
    $mod+Shift+0 exec ~/.config/sway/workspaces.sh 10 move
}

bindsym {
    $mod+$left focus left
    $mod+$down focus down
    $mod+$up focus up
    $mod+$right focus right
    $mod+Left focus left
    $mod+Down focus down
    $mod+Up focus up
    $mod+Right focus right

    $mod+Shift+$left move left
    $mod+Shift+$down move down
    $mod+Shift+$up move up
    $mod+Shift+$right move right
    $mod+Shift+Left move left
    $mod+Shift+Down move down
    $mod+Shift+Up move up
    $mod+Shift+Right move right
}

bindsym --locked {
    XF86AudioPlay       exec playerctl play-pause
    XF86AudioStop       exec playerctl stop
}

bindsym {
    XF86AudioForward    exec playerctl position +10
    XF86AudioNext       exec playerctl next
    XF86AudioPause      exec playerctl pause
    XF86AudioPrev       exec playerctl previous
    XF86AudioRewind     exec playerctl position -10
}


bindsym {
    Print        exec grimshot copy anything
    Ctrl+Print   exec grimshot savecopy anything
}

set $volume_helper_cmd /usr/libexec/sway/volume-helper

bindsym --locked {
    XF86AudioRaiseVolume exec \
        $volume_helper_cmd --limit "$volume_limit" --increase "$volume_step"
    XF86AudioLowerVolume exec \
        $volume_helper_cmd --limit "$volume_limit" --decrease "$volume_step"
    XF86AudioMute    exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $volume_helper_cmd
    XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
}

set $brightness_notification_cmd  command -v notify-send >/dev/null && \
        VALUE=$(brightnessctl --percentage get) && \
        notify-send -e -h string:x-canonical-private-synchronous:brightness \
            -h "int:value:$VALUE" -t 800 "Brightness: ${VALUE}%"

bindsym --locked XF86MonBrightnessDown exec \
        'STEP="$brightness_step" && brightnessctl -q set ${STEP:-5}%- -n && $brightness_notification_cmd'
bindsym --locked XF86MonBrightnessUp exec \
        'STEP="$brightness_step" && brightnessctl -q set +${STEP:-5}% && $brightness_notification_cmd'

bindgesture swipe:3:left workspace next
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:up workspace next
bindgesture swipe:3:down workspace prev

client.focused          #40a02b #eff1f5 #4c4f69 #40a02b #40a02b
client.focused_inactive #9ca0b0 #eff1f5 #4c4f69 #9ca0b0 #9ca0b0
client.unfocused        #9ca0b0 #eff1f5 #4c4f69 #9ca0b0 #9ca0b0
client.urgent           #fe640b #eff1f5 #fe640b #9ca0b0 #fe640b
client.placeholder      #9ca0b0 #eff1f5 #4c4f69 #9ca0b0 #9ca0b0
client.background       #eff1f5

smart_borders on
default_border pixel 4

bar {
    swaybar_command waybar
}
