#!/usr/bin/env chezmoi_modify_manager

source auto

ignore "KFileDialog Settings" "Show hidden files"
ignore "KFileDialog Settings" "Show Inline Previews"
ignore section "DirSelect Dialog"

ignore section regex "^Colors:.*"
ignore section regex "^ColorEffects:.*"

ignore "General" "AccentColor"
ignore "General" "ColorScheme"
ignore "General" "ColorSchemeHash"

ignore "WM" "activeBackground"
ignore "WM" "activeBlend"
ignore "WM" "activeForeground"
ignore "WM" "inactiveBackground"
ignore "WM" "inactiveBlend"
ignore "WM" "inactiveForeground"
